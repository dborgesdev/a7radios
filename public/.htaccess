RewriteEngine On
RewriteRule ^app/wp-content/a7-radios-media(?:/|$) - [F,NC]
RewriteRule ^app(?:/|$) - [L,NC]
RewriteRule ^\.vite(?:/|$) - [F]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^$ app/index.php [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^(?:radio/[a-z0-9-]{1,180}/?|sitemap(?:-[0-9]+)?\.xml|robots\.txt|radios/?|favoritos/?|login/?|cadastro/?|confirmar-email/?|recuperar-senha/?|termos/?|privacidade/?|painel(?:/dados|/radios(?:/nova|/[0-9]+/editar)?)?/?)$ app/index.php [L]

<IfModule mod_headers.c>
  <FilesMatch "^.+-[A-Za-z0-9_-]{8}\.(?:js|css|woff2|webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/assets/#"
  </FilesMatch>
</IfModule>
